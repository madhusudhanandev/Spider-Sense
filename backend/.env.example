# --- App ---
APP_NAME="Spider-Sense AI"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (Postgres; a Supabase Postgres connection string also works) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spidersense

# --- AI provider ---
# AI_PROVIDER=mock runs a deterministic keyword-based analyzer with no API key
# (useful for offline dev/demo). Set to "openai" + OPENAI_API_KEY for real analysis.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OCR ---
# "tesseract" requires the tesseract-ocr system package installed.
# Falls back to "mock" automatically if unavailable.
OCR_PROVIDER=tesseract

# --- Speech-to-text ---
# "mock" | "openai_whisper" (requires OPENAI_API_KEY above)
SPEECH_PROVIDER=mock

# --- URL / domain reputation (optional third-party APIs) ---
# "mock" runs the built-in heuristic analyzer only (no external calls).
URL_REPUTATION_PROVIDER=mock
URL_REPUTATION_API_KEY=
DOMAIN_AGE_API_KEY=

# --- Uploads ---
MAX_UPLOAD_MB=10
